# =============================================================================
# DecisionLens — .gitignore
# product code, README assets, evaluation results.
# Internal dev tooling and agent docs stay local only.
# =============================================================================

# --- Python runtime ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venv-docling/
venv/
ENV/

# --- Caches (rebuilt locally) ---
.pip_cache/
.hf_cache/
data/chunks/bm25_cache.pkl
data/embeddings_cache.npz

# --- Secrets (never commit) ---
.env
.env.*
*.key
*.pem
*.p12
secrets.*
*credentials*.json

# --- Node / frontend build ---
node_modules/
web/dist/
web/build/
web/.next/
.vite/
*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# --- Logs ---
*.log

# --- OS noise ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Architecture diagram sources (PNG in docs/architecture/ is the published asset) ---
docs/architecture/decisionlens-architecture.svg
scripts/generate_architecture_svg.py
scripts/export_architecture_png.py
scripts/verify_architecture_diagram.py

# --- UI capture / smoke tests (dev-only) ---
scripts/web_smoke.py
scripts/ui_capture.py
scripts/screenshot_app.py
scripts/smoke_ui.py
scripts/make_icon.py
scripts/make_web_icon.py
scripts/recapture_readme_shots.py

# Internal submission notes (local only, do not commit)
docs/SUBMISSION.md

# --- Dev screenshots (README keeps ui_main.png + ui_verdict.png only) ---
docs/screenshots/*
!docs/screenshots/ui_main.png
!docs/screenshots/ui_verdict.png
